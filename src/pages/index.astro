---
import Base from '../layouts/Base.astro';
import Grain from '../components/chrome/Grain.astro';
import Leader from '../components/chrome/Leader.astro';
import Header from '../components/chrome/Header.astro';
import SectionDots from '../components/chrome/SectionDots.astro';
import TransitionOverlay from '../components/chrome/TransitionOverlay.astro';
import Footer from '../components/chrome/Footer.astro';
import Opening from '../components/slides/Opening.astro';
import TheJury from '../components/slides/TheJury.astro';
import TheFacts from '../components/slides/TheFacts.astro';
import ExhibitA from '../components/slides/ExhibitA.astro';
import ExhibitB from '../components/slides/ExhibitB.astro';
import ExhibitC from '../components/slides/ExhibitC.astro';
import ExhibitD from '../components/slides/ExhibitD.astro';
import ExhibitE from '../components/slides/ExhibitE.astro';
import ExhibitF from '../components/slides/ExhibitF.astro';
import ExhibitG from '../components/slides/ExhibitG.astro';
import ExhibitH from '../components/slides/ExhibitH.astro';
import Verdict from '../components/slides/Verdict.astro';
import Credits from '../components/slides/Credits.astro';
import Lightbox from '../components/panels/Lightbox.astro';
import PanelA from '../components/panels/PanelA.astro';
import PanelB from '../components/panels/PanelB.astro';
import PanelC from '../components/panels/PanelC.astro';
import PanelD from '../components/panels/PanelD.astro';
import PanelE from '../components/panels/PanelE.astro';
import PanelF from '../components/panels/PanelF.astro';
import PanelG from '../components/panels/PanelG.astro';
import PanelH from '../components/panels/PanelH.astro';
import Contact from '../components/panels/Contact.astro';
import CvViewer from '../components/panels/CvViewer.astro';
import CaseFile from '../components/panels/CaseFile.astro';
---
<Base>
  <Grain />
  <Leader />
  <Header />
  <SectionDots />
  <main class="deck" id="deck">
    <Opening />
    <TheJury />
    <TheFacts />
    <ExhibitA />
    <ExhibitB />
    <ExhibitC />
    <ExhibitD />
    <ExhibitE />
    <ExhibitF />
    <ExhibitG />
    <ExhibitH />
    <Verdict />
    <Credits />
  </main>
  <TransitionOverlay />
  <Lightbox />
  <Footer />
  <PanelA />
  <PanelB />
  <PanelC />
  <PanelD />
  <PanelE />
  <PanelF />
  <PanelG />
  <PanelH />
  <Contact />
  <CvViewer />
  <CaseFile />
  <script src="../scripts/main.js"></script>
</Base>
