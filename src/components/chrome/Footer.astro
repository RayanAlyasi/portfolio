---
// Fixed footer: jury tracker, slide count and next button.

---
<footer class="foot">
  <div class="jury" aria-live="polite" aria-atomic="true"><svg viewBox="0 0 58 33" aria-hidden="true"><rect class="mt" x="10" y="10" width="38" height="13" rx="1.5"/></svg><div><b class="jcount">1 of 12</b><span>jurors convinced</span></div></div>
  <span class="count" aria-hidden="true">01 / 13</span>
  <button class="next" type="button" aria-label="Next section"><span class="hint" aria-hidden="true"><i>Scroll</i></span><span class="chev" aria-hidden="true"><svg viewBox="0 0 22 11" fill="none" stroke="currentColor"><path d="M2 2l9 7 9-7"/></svg><svg viewBox="0 0 22 11" fill="none" stroke="currentColor"><path d="M2 2l9 7 9-7"/></svg><svg viewBox="0 0 22 11" fill="none" stroke="currentColor"><path d="M2 2l9 7 9-7"/></svg></span></button>
</footer>
