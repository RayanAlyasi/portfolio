---
// Exhibit G: the objection, its rebuttal and the evidence.
import Pic from '../ui/Pic.astro';
---
<section class="slide bg-char ex" id="exhibit-g" data-photo="iris" data-hl="flipx" data-style="flip" data-mark="record" data-ink="#FFF" data-label="Exhibit G · Community" data-fx="wipe" data-fxc="#161616" data-flip="5">
  <div class="inner">
    <div class="obj">
      <div class="speak">
        <span class="who a" style="--d:.05s">Juror 5 objects</span>
        <div class="quote-wrap"><p class="big quote">“Sure. But does he do anything for anyone else?”</p><i class="strike" aria-hidden="true"></i></div>
        <p class="conv a" style="--d:calc(var(--t) + 1s)"><i></i>Juror 5 is convinced.</p>
      </div>
      <div class="pics a" style="--d:calc(var(--t) + .1s);--an:fade"><Pic name="bootGroup" alt="Rayan with Oracle Student Club members and bootcamp attendees" class="p1" sizes="(max-width: 820px) 1px, 30vw" /><Pic name="bootTalk" alt="A session at the club's From Zero to Cloud bootcamp" class="p2" sizes="(max-width: 820px) 1px, 20vw" /></div>
    </div>
    <div class="evi">
      <span class="badge a" style="--d:calc(var(--t) + .1s)"><i><b>G</b></i>Exhibit G</span>
      <h2 class="evh" style="--d:calc(var(--t) + .25s)">He builds for his community, too.</h2>
      <p class="lead a" style="--d:calc(var(--t) + .45s)">As Vice Lead of Technology at KAU’s new Oracle Student Club, he led 14 members and took the club’s website to production. Now he’s a technical consultant for it and the Programming Club, and he volunteered as an AI developer at Synapse, a non-profit under SDAIA.</p>
      <Pic name="bootGroup" alt="" class="mpic a" style="--d:calc(var(--t) + .5s)" sizes="(max-width: 820px) 92vw, 1px" />
      <ul class="stats a" style="--d:calc(var(--t) + .6s)"><li><b data-count="14">14</b><span>members led</span></li><li><b data-count="5">5</b><span>student clubs joined</span></li><li><b data-count="2">2</b><span>club servers run</span></li></ul>
      <button class="read a" style="--d:calc(var(--t) + .8s)" type="button" data-open="d-g">Read exhibit G <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></button>
    </div>
  </div>
</section>
