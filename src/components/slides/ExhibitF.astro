---
// Exhibit F: the objection, its rebuttal and the evidence.
import Pic from '../ui/Pic.astro';
---
<section class="slide bg-paper ex" id="exhibit-f" data-photo="drop" data-hl="scale" data-style="shout" data-mark="crumble" data-ink="#000" data-label="Exhibit F · People" data-fx="slab" data-fxc="#ECE9E3" data-flip="12">
  <div class="inner">
    <div class="obj">
      <div class="speak">
        <span class="who a" style="--d:.05s">Juror 12 objects</span>
        <div class="quote-wrap"><p class="big quote">“Can he lead people, or only machines?”</p><i class="strike" aria-hidden="true"></i></div>
        <p class="conv a" style="--d:calc(var(--t) + 1s)"><i></i>Juror 12 is convinced.</p>
      </div>
      <div class="pics a" style="--d:calc(var(--t) + .1s);--an:fade"><Pic name="boot" alt="Students coding during the From Zero to Cloud bootcamp" class="p1" sizes="(max-width: 820px) 1px, 30vw" /><Pic name="award" alt="Rayan honored at Engineering Day's closing ceremony" class="p2" sizes="(max-width: 820px) 1px, 20vw" /></div>
    </div>
    <div class="evi">
      <span class="badge a" style="--d:calc(var(--t) + .1s)"><i><b>F</b></i>Exhibit F</span>
      <h2 class="evh" style="--d:calc(var(--t) + .25s)">He leads teams and teaches rooms.</h2>
      <p class="lead a" style="--d:calc(var(--t) + .45s)">AI lead for KAU’s largest event, shipping 4 products with 10 developers. Then a two-day cloud bootcamp where 55+ students deployed their first containers, and a public talk at Tabby.</p>
      <Pic name="boot" alt="" class="mpic a" style="--d:calc(var(--t) + .5s)" sizes="(max-width: 820px) 92vw, 1px" />
      <ul class="stats a" style="--d:calc(var(--t) + .6s)"><li><b data-count="10">10</b><span>developers led</span></li><li><b data-count="125" data-suffix="+">125+</b><span>people taught</span></li><li><b data-count="4">4</b><span>products shipped</span></li></ul>
      <div class="readrow" style="--d:calc(var(--t) + .8s)"><button class="read a" type="button" data-open="d-f">Read exhibit F <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></button><span class="tap" aria-hidden="true"><i></i></span></div>
    </div>
  </div>
</section>
