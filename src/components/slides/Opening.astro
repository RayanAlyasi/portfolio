---
// Opening titles: name, proof points and the three entry actions.
// The name's letters are built here, not in the browser, so search engines and AI crawlers read it from the HTML.
import Fan from '../ui/Fan.astro';

let n = 0;
const nameRows = ['RAYAN', 'ALYASI'].map((word) => [...word].map((ch) => ({ ch, i: n++ })));
---
<section class="slide bg-paper s-open" id="opening" data-ink="#000" data-label="Opening">
  <div class="bars" aria-hidden="true"></div>
  <div class="fan" aria-hidden="true"><Fan /></div>
  <div class="open-title">
    <span class="pre">Inspired by 12 Angry Men (1957), my favourite film</span>
    <h1 class="big name" aria-label="Rayan Alyasi">{nameRows.map((row, r) => <>{r > 0 && ' '}<span class="row">{row.map(({ ch, i }) => <span class="ch" data-c={ch} aria-hidden="true" style={`--i:${i}`}>{ch}</span>)}</span></>)}</h1>
    <ul class="proof" aria-label="Highlights"><li style="--k:0">DevOps engineering intern at Tabby</li><li style="--k:1">BCG Jeel Tamooh Fellow</li><li style="--k:2">2× hackathon first place</li><li style="--k:3"><span data-yr="label">Year 2 of 4</span> at KAU</li></ul>
    <p class="open-sub">In the film, twelve jurors decide one case. Here, the case is me.</p>
    <div class="open-ctas"><button class="ocb solid" type="button" data-go="1" data-track="begin-case">Begin the case <span aria-hidden="true">↓</span></button><button class="ocb" type="button" data-go="3" data-track="skip-to-evidence">Skip to the evidence <span aria-hidden="true">→</span></button><button class="ocb" type="button" data-open="d-cv">View CV</button></div>
  </div>
</section>
