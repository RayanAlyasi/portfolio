---
// Exhibit D: the objection, its rebuttal and the evidence.
import Pic from '../ui/Pic.astro';
---
<section class="slide bg-paper ex" id="exhibit-d" data-photo="develop" data-hl="left" data-style="echo" data-mark="tear" data-ink="#000" data-label="Exhibit D · Wins" data-fx="square" data-fxc="#000000" data-flip="7,9">
  <div class="inner">
    <div class="obj">
      <div class="speak">
        <span class="who a" style="--d:.05s">Juror 7 objects</span>
        <div class="quote-wrap"><p class="big quote">“Fine. But can he actually build anything?”</p><i class="strike" aria-hidden="true"></i></div>
        <p class="conv a" style="--d:calc(var(--t) + 1s)"><i></i>Jurors 7 and 9 are convinced.</p>
      </div>
      <div class="pics a" style="--d:calc(var(--t) + .1s);--an:fade"><Pic name="tcsWin" alt="Team Wafir holding the TCS Sustainathon first-prize trophy" class="p1" sizes="(max-width: 820px) 1px, 30vw" /><Pic name="th1" alt="Team FieldLog receiving first place at TechHub" class="p2 round" sizes="(max-width: 820px) 1px, 20vw" /></div>
    </div>
    <div class="evi">
      <div class="evtags a" style="--d:calc(var(--t) + .1s)"><span class="badge"><i><b>D</b></i>Exhibit D</span><span class="lg lg-tcs" role="img" aria-label="Tata Consultancy Services"></span><span class="lg lg-techhub" role="img" aria-label="TechHub"></span></div>
      <h2 class="evh" style="--d:calc(var(--t) + .25s)">Two hackathons. Two first places.</h2>
      <p class="lead a" style="--d:calc(var(--t) + .45s)">Wafir, an AI digital twin that finds what drives a building’s power bill, won TCS Sustainathon 2026. FieldLog, which logs field inspections by voice in 20 seconds, won TechHub after 48 hours of building.</p>
      <Pic name="tcsWin" alt="" class="mpic a" style="--d:calc(var(--t) + .5s)" sizes="(max-width: 820px) 92vw, 1px" />
      <ul class="stats a" style="--d:calc(var(--t) + .6s)"><li><b>SAR 15K</b><span>TCS grand prize</span></li><li><b data-count="250" data-suffix="+">250+</b><span>registrations at TCS</span></li><li><b>48 h</b><span>idea to live product</span></li></ul>
      <div class="readrow" style="--d:calc(var(--t) + .8s)"><button class="read a" type="button" data-open="d-d">Read exhibit D <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></button><span class="tap" aria-hidden="true"><i></i></span></div>
    </div>
  </div>
</section>
