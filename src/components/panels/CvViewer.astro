---
// CV viewer with a direct PDF download.
import Pic from '../ui/Pic.astro';
---
<dialog class="drawer cvview" id="d-cv" aria-labelledby="d-cv-h">
  <div class="d-head"><span id="d-cv-h">Rayan Alyasi · CV</span><span class="cv-actions"><a class="cv-dl" href="/cv/Rayan-Alyasi-CV.pdf" download data-track="cv-download"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 2v9M4 7.5 8 11.5 12 7.5M3 14h10"/></svg> Download PDF</a><button class="d-close" type="button">Close</button></span></div>
  <p class="cvnote" role="status" aria-live="polite"></p>
  <div class="cv-page"><Pic name="cv" alt="Rayan Alyasi’s one-page CV: summary, experience at Tabby, BCG, Lucidya and Fiverr, projects, leadership and volunteering, awards, skills and education" sizes="(max-width: 940px) 96vw, 860px" /></div>
</dialog>
