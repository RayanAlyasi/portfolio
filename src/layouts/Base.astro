---
// Document shell: metadata, social cards, structured data, fonts, analytics and global styles.
import '@fontsource/big-shoulders-display/latin-700';
import '@fontsource/big-shoulders-display/latin-900';
import '@fontsource/libre-franklin/latin-400';
import '@fontsource/libre-franklin/latin-500';
import '@fontsource/libre-franklin/latin-600';
import '@fontsource/libre-franklin/latin-700';
import '../styles/index.css';
import displayFont from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-900-normal.woff2?url';
import bodyFont from '@fontsource/libre-franklin/files/libre-franklin-latin-400-normal.woff2?url';
import { site, structuredData } from '../data/site';

const umamiHost = import.meta.env.PUBLIC_UMAMI_HOST?.replace(/\/$/, '');
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
// Every slide's address shows the same page, so all of them name the home page as the original for search engines.
const canonical = new URL('/', site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="Rayan" />
    <meta property="profile:last_name" content="Alyasi" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.shareTitle} />
    <meta property="og:description" content={site.shareDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rayan Alyasi: Not Just a Student, a portfolio inspired by 12 Angry Men" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.shareTitle} />
    <meta name="twitter:description" content={site.shareDescription} />
    <meta name="twitter:image" content={`${site.url}/og-image.png`} />
    {/* PNG first: Google Search does not accept SVG favicons and prefers ones larger than 48px. */}
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {umamiHost && umamiId && (
      <>
        <script defer src={`${umamiHost}/script.js`} data-website-id={umamiId} data-domains="alyasi.tech" data-exclude-hash="true" data-before-send="umamiBeforeSend" />
        <script defer src={`${umamiHost}/recorder.js`} data-website-id={umamiId} />
      </>
    )}
    <noscript><style>{`html,body{height:auto;overflow:auto}.deck{position:static}.slide{position:relative;inset:auto;visibility:visible;min-height:100vh}.inner{position:relative;inset:auto;padding:90px 6vw}.a,.chair,.plate,.ballot,.callouts li,.stats li,.proof li,.open-ctas{opacity:1!important;transform:none!important}.leader,.ov,.dots,.foot,.rain{display:none!important}`}</style></noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
